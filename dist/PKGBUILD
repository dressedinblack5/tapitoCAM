# Maintainer: Anonymous <root@localhost>

pkgname=tapitocam
pkgver=1.2.0
pkgrel=1
pkgdesc="TP-Link Tapo Camera RTSP Viewer & PTZ Controller"
arch=('any')
url="https://github.com/dressedinblack5/tapitoCAM"
license=('Apache')
depends=(
  'python'
  'python-pyside6'
  'mpv'
  'python-mpv'
)
makedepends=()
optdepends=('python-onvif-zeep: PTZ control via ONVIF')
source=(
  "tapitocam.sh"
  "tapitocam_gui.py"
  "tapitocam_cli.py"
  "cameratile.py"
  "cameraconfig.py"
  "cameradialog.py"
  "motionmonitor.py"
  "styles.py"
  "utils.py"
  "tapitoCAM.desktop"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/tapitocam.sh"        "$pkgdir/usr/bin/tapitocam"
  install -Dm755 "$srcdir/tapitocam_gui.py"    "$pkgdir/usr/bin/tapitocam-gui"
  install -Dm755 "$srcdir/tapitocam_cli.py"    "$pkgdir/usr/bin/tapitocam-cli-helper"

  # Python modules needed by the GUI (resolve site-packages at build time)
  python_site=$(python3 -c "import site; print(site.getsitepackages()[0])")
  install -Dm644 "$srcdir/cameratile.py"       "$pkgdir/$python_site/"
  install -Dm644 "$srcdir/cameraconfig.py"     "$pkgdir/$python_site/"
  install -Dm644 "$srcdir/cameradialog.py"     "$pkgdir/$python_site/"
  install -Dm644 "$srcdir/motionmonitor.py"    "$pkgdir/$python_site/"
  install -Dm644 "$srcdir/styles.py"           "$pkgdir/$python_site/"
  install -Dm644 "$srcdir/utils.py"            "$pkgdir/$python_site/"

  # Desktop entry
  sed 's|Exec=.*|Exec=/usr/bin/tapitocam-gui|' \
    "$srcdir/tapitoCAM.desktop" \
    > "$pkgdir/usr/share/applications/tapitoCAM.desktop"
  chmod 644 "$pkgdir/usr/share/applications/tapitoCAM.desktop"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
